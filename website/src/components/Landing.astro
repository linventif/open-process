---
import { messages, languages, languageNames, languagePaths, type Language } from "../lib/messages";
import { cloudApp } from "../lib/site";
interface Props { lang: Language }
const { lang } = Astro.props;
const t = messages[lang];
const appPath = new URL(cloudApp).pathname;
const releaseCopy = {
  initial: t.releaseInitial, none: t.releaseNone, error: t.releaseError,
  available: t.releaseAvailable, download: t.download, viewReleases: t.viewReleases,
};
---
  <a class="skip-link" href="#main">{t.skip}</a>
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="#" aria-label="Open Process"><img src="/assets/logo.svg" width="45" height="45" alt=""><span>Open Process<span class="brand-dot">.</span></span></a>
      <nav aria-label={t.navLabel}>
        <a href="#explore">{t.navExplore}</a>
        <a href="#learn">{t.navLearn}</a>
        <a href="https://github.com/linventif/open-process" class="nav-github">GitHub <span aria-hidden="true">↗</span></a>
      </nav>
      <div class="header-actions">
        <details class="language-dropdown" id="language-dropdown">
          <summary class="language-toggle" aria-label={t.language}><span aria-hidden="true">◎</span><span>{lang.toUpperCase()}</span><span class="language-chevron" aria-hidden="true">▾</span></summary>
          <ul class="language-options">
            {languages.map(language => <li><a href={languagePaths[language]} hreflang={language} lang={language} aria-current={language === lang ? "page" : undefined}><span>{languageNames[language]}</span>{language === lang && <span aria-hidden="true">✓</span>}</a></li>)}
          </ul>
        </details>
        <a class="button button-small button-dark" href={appPath}><span>{t.getApp}</span><span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </header>

  <main id="main" data-language={lang}>
    <section class="hero container" aria-labelledby="hero-title">
      <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span><span>{t.heroEyebrow}</span></p>
      <div class="hero-layout">
        <div>
          <h1 id="hero-title"><span>{t.heroLine1}</span><br><span>{t.heroLine2}</span><span class="accent">.</span></h1>
          <p class="hero-description">{t.heroDescription}</p>
          <div class="hero-actions"><a class="button button-dark" href={appPath}><span>{t.openWeb}</span><span aria-hidden="true">↗</span></a><a class="text-link" href="#download"><span>{t.download}</span><span aria-hidden="true">↓</span></a></div>
          <p class="platform-note">{t.platformNote}</p>
        </div>
        <aside class="process-note">
          <svg class="process-sketch" viewBox="0 0 300 145" fill="none" aria-hidden="true">
            <path d="M58 67H116M179 67H237" stroke="currentColor" stroke-width="2"/>
            <path d="m109 62 7 5-7 5m121-10 7 5-7 5" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
            <circle cx="37" cy="67" r="21" stroke="currentColor" stroke-width="2"/>
            <circle cx="37" cy="67" r="6" fill="#e39b2e"/>
            <rect x="116" y="43" width="63" height="48" rx="7" fill="#f2e5c8" stroke="currentColor" stroke-width="2"/>
            <path d="m138 67 7 7 12-15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="258" cy="67" r="21" stroke="currentColor" stroke-width="4"/>
            <path d="M37 107v12h221v-12" stroke="currentColor" stroke-opacity=".22" stroke-dasharray="3 4"/>
          </svg>
          <p><span>{t.noteLine1}</span><br><span>{t.noteLine2}</span></p>
          <span class="mono">BPMN ↔ PETRI ↔ ANALYSIS</span>
        </aside>
      </div>
      <div class="hero-bottom"><span>{t.builtFor}</span><span class="mono">RUST / NATIVE + WASM</span></div>
    </section>

    <section class="showcase container" id="explore" aria-label={t.exploreLabel}>
      <div class="showcase-toolbar">
        <div class="preview-tabs" role="tablist" aria-label={t.viewsLabel}>
          <button id="tab-bpmn" role="tab" aria-selected="true" aria-controls="preview-panel" tabindex="0" data-view="bpmn" data-caption={t.bpmnCaption} data-alt={t.bpmnAlt}><span class="tab-symbol" aria-hidden="true">◇</span>BPMN</button>
          <button id="tab-petri" role="tab" aria-selected="false" aria-controls="preview-panel" tabindex="-1" data-view="petri" data-caption={t.petriCaption} data-alt={t.petriAlt}><span class="tab-symbol" aria-hidden="true">⊙</span><span>{t.petriTab}</span></button>
          <button id="tab-mining" role="tab" aria-selected="false" aria-controls="preview-panel" tabindex="-1" data-view="mining" data-caption={t.miningCaption} data-alt={t.miningAlt}><span class="tab-symbol" aria-hidden="true">⌁</span><span>{t.miningTab}</span></button>
          <button id="tab-split" role="tab" aria-selected="false" aria-controls="preview-panel" tabindex="-1" data-view="split" data-caption={t.splitCaption} data-alt={t.splitAlt}><span class="tab-symbol" aria-hidden="true">▥</span><span>{t.splitTab}</span></button>
        </div>
        <span class="preview-label"><span class="status-dot" aria-hidden="true"></span><span>{t.realApp}</span></span>
      </div>
      <div id="preview-panel" role="tabpanel" aria-labelledby="tab-bpmn" tabindex="0">
        <button id="expand-preview" class="screenshot-button" type="button" aria-label={t.expandLabel}><img id="preview-image" src="/assets/bpmn.webp" width="1400" height="860" fetchpriority="high" alt={t.bpmnAlt}><span class="expand-hint"><span aria-hidden="true">⤢</span><span>{t.enlarge}</span></span></button>
      </div>
      <div class="showcase-caption"><p id="preview-caption">{t.bpmnCaption}</p><span class="mono" id="preview-number">01 / 04</span></div>
    </section>

    <section class="features container" aria-labelledby="features-title">
      <div class="section-heading"><p class="eyebrow">{t.featuresEyebrow}</p><h2 id="features-title"><span>{t.featuresLine1}</span><br><span>{t.featuresLine2}</span></h2><p>{t.featuresIntro}</p></div>
      <div class="feature-grid">
        <article class="feature"><span class="feature-number mono">{t.modelEyebrow}</span><div class="feature-glyph" aria-hidden="true">◇<span>→</span>▢</div><h3>{t.modelTitle}</h3><p>{t.modelBody}</p><ul><li>{t.modelPoint1}</li><li>{t.modelPoint2}</li><li>{t.modelPoint3}</li></ul></article>
        <article class="feature"><span class="feature-number mono">{t.analyseEyebrow}</span><div class="feature-glyph petri-glyph" aria-hidden="true">⊙<span>→</span>▯<span>→</span>○</div><h3>{t.analyseTitle}</h3><p>{t.analyseBody}</p><ul><li>{t.analysePoint1}</li><li>{t.analysePoint2}</li><li>{t.analysePoint3}</li></ul></article>
        <article class="feature"><span class="feature-number mono">{t.discoverEyebrow}</span><div class="feature-glyph mining-glyph" aria-hidden="true">ABCD<span>→</span>α</div><h3>{t.discoverTitle}</h3><p>{t.discoverBody}</p><ul><li>{t.discoverPoint1}</li><li>{t.discoverPoint2}</li><li>{t.discoverPoint3}</li></ul></article>
      </div>
    </section>

    <section class="learning" id="learn" aria-labelledby="learn-title">
      <div class="container learning-layout">
        <div class="learning-copy"><p class="eyebrow"><span class="status-dot" aria-hidden="true"></span><span>{t.learnEyebrow}</span></p><h2 id="learn-title"><span>{t.learnLine1}</span><br><span>{t.learnLine2}</span><span class="accent">.</span></h2><p>{t.learnIntro}</p><a class="text-link light-link" href="https://github.com/linventif/open-process#process-discovery-event-logs"><span>{t.learnLink}</span><span aria-hidden="true">↗</span></a></div>
        <ol class="learning-steps"><li><span class="step-marker mono">01</span><div><h3>{t.step1Title}</h3><p>{t.step1Body}</p></div></li><li><span class="step-marker mono">02</span><div><h3>{t.step2Title}</h3><p>{t.step2Body}</p></div></li><li><span class="step-marker mono">03</span><div><h3>{t.step3Title}</h3><p>{t.step3Body}</p></div></li></ol>
      </div>
      <div class="container learning-footer"><span class="mono">M′ = M + C · σ</span><span>{t.learnFooter}</span></div>
    </section>

    <section class="downloads container" id="download" aria-labelledby="download-title">
      <div class="section-heading"><p class="eyebrow">{t.downloadEyebrow}</p><h2 id="download-title">{t.downloadTitle}</h2><p>{t.downloadIntro}</p></div>
      <div class="release-status" data-release-copy={JSON.stringify(releaseCopy)}><span class="status-dot" aria-hidden="true"></span><p id="release-status" aria-live="polite">{t.releaseInitial}</p><a id="release-link" href="https://github.com/linventif/open-process/releases"><span>{t.allReleases}</span><span aria-hidden="true">↗</span></a></div>
      <div class="download-grid">
        <article class="download-card"><svg class="os-icon" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true"><path d="M3 6.5 14 5v10H3zm13-1.8L29 3v12H16zM3 17h11v10L3 25.5zm13 0h13v12l-13-1.7z"/></svg><h3>Windows</h3><p class="os-detail">Intel / AMD · 64-bit</p><p class="download-note">{t.windowsNote}</p><a class="button button-outline download-link" data-platform="windows" href="https://github.com/linventif/open-process/releases"><span data-download-label>{t.viewReleases}</span><span aria-hidden="true">↗</span></a></article>
        <article class="download-card"><svg class="os-icon" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true"><path d="M21 2c.2 3-1.8 5.5-4.7 5.6C16 4.8 18.2 2.3 21 2M25.2 23.7c-.8 1.8-2.1 4.1-3.9 4.2-1.7.1-2.2-1-4.3-1-2.2 0-2.8 1-4.4 1C9.1 27.8 5.7 20.1 6.5 15.5c.6-3.5 3-5.8 5.9-5.9 1.8 0 3 1.1 4.5 1.1 1.4 0 2.7-1.1 4.6-1.1 2.1.1 3.8 1 4.8 2.4-4.1 2.4-3.6 7.5.4 9.1-.3.9-.8 1.8-1.5 2.6"/></svg><h3>macOS</h3><label class="sr-only" for="mac-architecture">{t.macArchitecture}</label><select id="mac-architecture" class="os-select"><option value="mac-arm">{t.macArm}</option><option value="mac-intel">Intel · 64-bit</option></select><p class="download-note">{t.macNote}</p><a class="button button-outline download-link" data-platform="mac" href="https://github.com/linventif/open-process/releases"><span data-download-label>{t.viewReleases}</span><span aria-hidden="true">↗</span></a></article>
        <article class="download-card"><svg class="os-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M11 12V8a5 5 0 0 1 10 0v4c0 3 5 7 5 11 0 3-4 5-10 5S6 26 6 23c0-4 5-8 5-11Z"/><path d="m12 27-6 2-3-3 5-5m12 6 6 2 3-3-5-5m-11-15v3m6-3v3m-6 3 3 2 3-2"/></svg><h3>Linux</h3><p class="os-detail">Intel / AMD · x86_64</p><p class="download-note">{t.linuxNote}</p><a class="button button-outline download-link" data-platform="linux" href="https://github.com/linventif/open-process/releases"><span data-download-label>{t.viewReleases}</span><span aria-hidden="true">↗</span></a></article>
      </div>
      <div class="browser-callout"><div class="browser-icon" aria-hidden="true">◎</div><div><h3>{t.browserTitle}</h3><p>{t.browserBody}</p></div><a class="text-link" href={appPath}><span>{t.browserLink}</span><span aria-hidden="true">↗</span></a></div>
    </section>

    <section class="open-source container" aria-labelledby="source-title"><div><p class="eyebrow">{t.sourceEyebrow}</p><h2 id="source-title">{t.sourceTitle}</h2><p>{t.sourceBody}</p><div class="source-links"><a class="text-link" href="https://github.com/linventif/open-process"><span>{t.sourceLink}</span><span aria-hidden="true">↗</span></a><a class="text-link muted" href="https://github.com/linventif/open-process/issues"><span>{t.issueLink}</span><span aria-hidden="true">↗</span></a></div></div><div class="terminal"><div class="terminal-heading"><span class="terminal-dot" aria-hidden="true"></span><span>{t.terminalTitle}</span></div><pre><code><span class="code-comment"># <span>{t.terminalComment}</span></span>
git clone https://github.com/linventif/open-process.git
cd open-process
<span class="code-accent">cargo run --release</span></code></pre><a href="https://github.com/linventif/open-process#running">{t.buildInstructions}</a></div></section>
  </main>
  <footer class="container site-footer"><a class="brand" href="#"><img src="/assets/logo.svg" width="35" height="35" alt=""><span>Open Process<span class="brand-dot">.</span></span></a><p>{t.footerText}</p><a href="https://github.com/linventif/open-process" class="mono">GITHUB ↗</a><span class="mono">MIT / APACHE 2.0</span></footer>

  <dialog id="preview-dialog" aria-labelledby="dialog-caption"><div class="dialog-toolbar"><p id="dialog-caption"></p><button id="close-preview" type="button" aria-label={t.closeLabel}>×</button></div><img id="dialog-image" src="/assets/bpmn.webp" width="1400" height="860" alt={t.bpmnAlt} loading="lazy"></dialog>
<script>import "../scripts/site";</script>
