---
import { messages, type Language } from "../lib/messages";
interface Props { lang: Language }
const { lang } = Astro.props;
const t = messages[lang];
---
<button class="color-mode-toggle" id="color-mode-toggle" type="button" aria-label={t.switchDarkMode} title={t.switchDarkMode} data-light-label={t.switchLightMode} data-dark-label={t.switchDarkMode}>
  <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
    <path class="color-mode-moon" d="M20.3 14.2A8.7 8.7 0 0 1 9.8 3.7a8.7 8.7 0 1 0 10.5 10.5Z" />
    <g class="color-mode-sun"><circle cx="12" cy="12" r="4" /><path d="M12 1v3m0 16v3M1 12h3m16 0h3M4.2 4.2l2.1 2.1m11.4 11.4 2.1 2.1M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1" /></g>
  </svg>
</button>
