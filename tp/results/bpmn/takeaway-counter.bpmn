      <bpmn:incoming>Flow_36</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Activity_5" name="Bake">
      <bpmn:documentation>Source: corrected Counter event log(s). Observed assignments (event counts): Patrick: 52, Robert: 8. Role lane titles marked * are inferred groupings. No task duration or execution cost is recorded; zero-valued model defaults are not measurements.</bpmn:documentation>
      <bpmn:extensionElements>
        <op:activityMetrics cost="0" duration="0"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:task>
