          },
          "w": 190.0
        },
        {
          "cost": 0.0,
          "documentation": "Customer Location is a geographic category in Sales, not a street address or a case-linked delivery instruction. Its proposed use in planning is an explicit modeling assumption.",
          "duration": 0.0,
